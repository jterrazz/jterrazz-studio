{
    // The harness has no entry of its own: every module under `specs/` is reached by
    // Vitest, through the runner `vitest.config.ts` names.
    "entry": ["specs/**/*.specification.ts", "specs/**/*.test.ts"],
    "ignoreBinaries": [
        // The Go toolchain, which the runner shells out to for the test binary — a
        // machine requirement of this repository, never an npm dependency.
        "go",
        // The runner @jterrazz/test carries: this repo declares no runner of its own,
        // so the binary `test:e2e` calls has no direct dependency to name.
        "vitest"
    ]
}
